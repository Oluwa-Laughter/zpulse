# ─────────────────────────────────────────────────────────────────────────────
# ZPulse configuration. Copy to .env.local and fill in.
#
#   cp .env.local.example .env.local
#
# Every variable here is read server-side only. None of it reaches the browser:
# there is no NEXT_PUBLIC_* anything in this project, and the UI is only ever
# told the *host* it is talking to, never the URL — because hosted providers put
# the access token in the URL path.
#
# Every name below is read by the code. If you set something that is not listed
# here, nothing reads it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────────────────────
# live = talk to a real node (requires ZCASH_RPC_URL below)
# demo = render from a deterministic synthetic node that emulates zebrad, so the
#        whole UI is explorable with no credentials.
#
# Demo mode is badged in the UI and is NEVER used as a silent fallback when a live
# call fails. A broken node has to look broken.
#
# Leave this unset and the mode is inferred: a URL means live, no URL means demo. That
# is almost always what you want, so it is commented out — uncomment only to force
# demo mode while an endpoint is configured.
# ZCASH_RPC_MODE=demo

# Which node the synthetic endpoint pretends to be. Read only in demo mode.
#   zebra        (default) a current zebrad: every method ZPulse uses answers
#   zebra-legacy an older zebrad: getmempoolinfo/getnetworkinfo return -32601 and
#                getblock omits per-pool valueDelta, so the turnstile has to derive
#                deltas from consecutive chain totals. This is the profile that
#                exercises the version-skew paths the /node page is about.
# ZPULSE_DEMO_PROFILE=zebra

# ── Node endpoint (Zebra Node) ───────────────────────────────────────────────
# ZPulse connects directly to the official Zcash Foundation Zebra node (`zebrad`).
#
# (a) Local Native Zebra Node (Mainnet or Testnet):
#     Start with `npm run node:mainnet` or `npm run node:testnet`
#     ZCASH_RPC_URL=http://127.0.0.1:8232 (Mainnet) or http://127.0.0.1:18232 (Testnet)
#
# (b) Local Zebra with Cookie Auth:
#     ZCASH_RPC_URL=http://127.0.0.1:8232
#     ZCASH_RPC_COOKIE_FILE=~/.cache/zebra/.cookie
#
# (c) Demo Mode:
#     Leave ZCASH_RPC_URL empty or unset to explore with the synthetic Zebra fixture.
ZCASH_RPC_URL=http://127.0.0.1:8232
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=

# Extra request headers — this is where a hosted provider's API key goes. Either
# form works:
#
#   ZCASH_RPC_HEADERS=x-api-key: abc123
#   ZCASH_RPC_HEADERS={"x-api-key":"abc123"}
#
# Separate multiple headers with commas or newlines. Applied after any auth header
# ZPulse builds itself, so a provider wanting `Authorization: Bearer <token>` can
# set that here and it wins. A malformed value fails at startup rather than being
# dropped, because a silently-missing API key just looks like a 401 from the far end.
#
# The values are credentials and are treated as such: the /node page and every error
# message name the header but never its value.
ZCASH_RPC_HEADERS=

# Zebra's RPC cookie. The file holds a single `__cookie__:<secret>` line, which is
# sent as HTTP basic auth exactly as written. Zebra rewrites the secret on every
# restart; ZPulse re-reads the file when its mtime changes, so a node restart does
# not need an app restart. Ignored when USER/PASSWORD above are set.
ZCASH_RPC_COOKIE_FILE=

# Fail loudly instead of hanging a page render.
ZCASH_RPC_TIMEOUT_MS=8000

# zcashd ignores this field's value; Zebra is strict about "2.0". "2.0" works for
# both — this is only an escape hatch for a proxy that disagrees.
ZCASH_RPC_JSONRPC_VERSION=2.0

# ── Cache ────────────────────────────────────────────────────────────────────
# Zcash targets ~75s blocks, so polling the tip faster than this buys nothing and
# spends your provider's request quota. Block data is immutable and cached by hash
# regardless of these values.
ZPULSE_TIP_TTL_MS=20000
ZPULSE_SLOW_TTL_MS=120000

# ── Analysis windows ─────────────────────────────────────────────────────────
# Blocks scanned for the turnstile chart and the per-block privacy mix. Each block
# costs one RPC call and is then cached forever, so a wider window is a one-time
# cost — but the FIRST load pays all of it. The UI can request other sizes; the
# server clamps them (144 turnstile, 32 privacy) so no query parameter can make
# ZPulse walk the chain.
ZPULSE_TURNSTILE_WINDOW=12
ZPULSE_PRIVACY_WINDOW=6

# ── Poller (optional) ────────────────────────────────────────────────────────
# The poller records a time series so /node can draw history. It works by calling
# /api/cron/poll, so in production you can point Vercel Cron or a GitHub Action at
# that route instead of running a long-lived process.
#
# That route spends real RPC requests and can fire webhooks, so it is guarded:
#   secret set    → the secret is required, from anywhere
#   secret unset  → the route only answers on localhost
# That keeps `npm run poll` working out of the box without leaving a public
# amplifier in the default configuration.
ZPULSE_CRON_SECRET=

# Where the JSONL history file lives. Defaults to data/history.jsonl. On a
# read-only filesystem (most serverless platforms) the store falls back to memory
# and reports itself as non-durable on the /node page rather than pretending.
ZPULSE_HISTORY_PATH=data/history.jsonl

# Which ZPulse instance `npm run poll` should tick. Read by scripts/poll.mjs only.
ZPULSE_URL=http://localhost:3000

# ── Alert thresholds ─────────────────────────────────────────────────────────
# Used by lib/alerts/rules.ts, and shown on the /node page so the numbers on
# screen match the rules that produced them.
ZPULSE_MIN_PEERS=3
ZPULSE_STALL_MINUTES=20
ZPULSE_MIN_SYNC_PROGRESS=0.999

# ── Alert delivery (optional) ────────────────────────────────────────────────
# Sent on state transitions only — when an alert starts and when it clears, never
# repeatedly while it is ongoing. Leave blank to log server-side only.
#
# These URLs are credentials: the token is in the path. They are never echoed back
# to the browser; /api/history reports only whether each sink is configured.
ZPULSE_ALERT_DISCORD_WEBHOOK=
ZPULSE_ALERT_WEBHOOK=
