{
  "name": "zpulse",
  "version": "0.1.0",
  "private": true,
  "description": "Zcash network observatory: shielded supply integrity, turnstile migration, and per-block privacy mix, live from a Zcash node.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-extensions.mjs scripts/verify.mjs",
    "probe": "node scripts/probe.mjs",
    "poll": "node scripts/poll.mjs",
    "tocurl": "node scripts/toCurl.mjs",
    "node:mainnet": "./scripts/zebrad.sh mainnet",
    "node:testnet": "./scripts/zebrad.sh testnet",
    "node:install": "./scripts/zebrad.sh install",
    "node:init": "./scripts/zebrad.sh init",
    "node:status": "./scripts/zebrad.sh status",
    "node:stop": "./scripts/zebrad.sh stop",
    "node:start": "./scripts/zebrad.sh mainnet"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
