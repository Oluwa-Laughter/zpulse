{
  "name": "zpulse",
  "version": "0.1.0",
  "private": true,
  "description": "Zcash network observatory: shielded supply integrity, turnstile migration, and per-block privacy mix, live from a Zcash node.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-extensions.mjs scripts/verify.mjs",
    "probe": "node scripts/probe.mjs",
    "poll": "node scripts/poll.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
